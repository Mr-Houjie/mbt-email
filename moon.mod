name = "houjie/mbt-markdown"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/Mr-Houjie/mbt-markdown"

license = "MIT"

keywords = ["markdown", "parser", "html", "commonmark"]

preferred_target = "wasm-gc"

description = "A Markdown-to-HTML parser and renderer written in MoonBit. Supports headings, emphasis, code blocks, links, images, blockquotes, lists, and thematic breaks."
